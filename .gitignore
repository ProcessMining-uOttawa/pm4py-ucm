# Local-only artifacts (logs, generated UCMs, rendered PNGs from demos)
*.log
demo/*.jucm
demo/*.png
!demo/*.sample

# Claude Code / agent-harness local settings
.claude/*
# ...except the project's own skills, which belong to the repo and
# have to travel with it. (Re-including a child needs the PARENT
# not to be excluded, hence `.claude/*` rather than `.claude/`.)
!.claude/skills/

# Tutorial notebook output (regenerated on each run)
demo/output/
demo/tutorial_output/
demo/scenario_output/

# Event logs ship zipped — the notebook unzips them on first use.
demo/ClaimsPaymentLog.xes
demo/IssueTracker.xes

# Private / local-only event logs — never commit these (defensive:
# the real files live outside the repo tree).
BC-eventlog.csv
*BC-eventlog*
*-private.csv
